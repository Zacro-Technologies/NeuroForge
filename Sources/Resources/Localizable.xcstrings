        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点 P は x %1$lld、y %2$lld から始まります。その座標ペアを反時計回りに 90 度回転します。"
          }
        }
      }
    },
    "Point P is at (%lld, %lld). Where is P after a 90° counterclockwise rotation about the origin?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Point P is at (%1$lld, %2$lld). Where is P after a 90° counterclockwise rotation about the origin?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
