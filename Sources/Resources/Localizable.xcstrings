    "identify positive, negative, and procedural controls; block or randomize a nuisance variable; and match the conclusion to the design": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "identify positive, negative, and procedural controls; block or randomize a nuisance variable; and match the conclusion to the design"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "陽性対照、陰性対照、手順対照を特定し、攪乱変数をブロック化または無作為化し、結論を研究デザインに適合させる"
          }
        }
      }
    },
    "identify the invariant structure, map each quantity or condition, and verify that the transferred solution still satisfies its assumptions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "identify the invariant structure, map each quantity or condition, and verify that the transferred solution still satisfies its assumptions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不変な構造を特定し、各量や条件を対応づけ、移した解法が元の仮定を満たすか検証する"
          }
        }
      }
    },
    "identify the limiting reagent from coefficient-adjusted amounts, compute theoretical yield, and diagnose a mole-ratio error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "identify the limiting reagent from coefficient-adjusted amounts, compute theoretical yield, and diagnose a mole-ratio error"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "化学量論係数で補正した量から限定反応物を特定し、理論収量を計算し、モル比の誤りを診断する"
          }
        }
      }
    },
    "identify the relevant sample space, compute a conditional probability, and explain how the base rate changes the conclusion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "identify the relevant sample space, compute a conditional probability, and explain how the base rate changes the conclusion"
