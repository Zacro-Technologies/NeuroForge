        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り当ては改善しますが、得点の差はワークショップではなく、尺度の異なるテストによって生じる可能性があります。"
          }
        }
      }
    },
    "This improves measurement, but self-selection can still connect prior skill to workshop participation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This improves measurement, but self-selection can still connect prior skill to workshop participation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定は改善しますが、自分で参加を選ぶため、事前の技能とワークショップへの参加が結び付いたままになる可能性があります。"
          }
        }
      }
    },
    "This instructional example does not change your skill estimate. Only the displayed assignments run; imported code is never executed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This instructional example does not change your skill estimate. Only the displayed assignments run; imported code is never executed."
          }
