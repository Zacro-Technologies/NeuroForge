    "Row swapping preserves the solution set of a linear system but does not preserve determinant value; it changes orientation and therefore flips the sign.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Row swapping preserves the solution set of a linear system but does not preserve determinant value; it changes orientation and therefore flips the sign."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行交換は線形システムのソリューションセットを保持しますが、行列値を保持しません。方向が変更されるため、符号が裏返されます。"
          }
        }
      }
    },
    "Rows within the same hospitals share device, workflow, and referral patterns. Random row holdout preserves those shortcuts, while site-level holdout tests the stated deployment boundary.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rows within the same hospitals share device, workflow, and referral patterns. Random row holdout preserves those shortcuts, while site-level holdout tests the stated deployment boundary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ病院内の行は、デバイス、ワークフロー、および紹介パターンを共有します。 ランダムな行ホールドアウトはそれらのショートカットを保持しますが、サイトレベルのホールドアウトは指定された展開境界をテストします。"
          }
        }
      }
    },
