        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この練習例はスキルの推定に使われません。表示された代入だけを実行し、取り込んだコードは実行しません。"
          }
        }
      }
    },
    "This intentionally creates a separate source with the same content. Future source review and generated questions may overlap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This intentionally creates a separate source with the same content. Future source review and generated questions may overlap."
          }
