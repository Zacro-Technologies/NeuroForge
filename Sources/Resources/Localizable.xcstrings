    "Substitute 1 for the named variable in the displayed term.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Substitute 1 for the named variable in the displayed term."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された項で、指定された変数に 1 を代入します。"
          }
        }
      }
    },
    "Substitute count = 1 into the loop condition.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ループ条件にcount = 1を代入する。"
          }
        }
      }
    },
    "Substitute t = (v − v₀)/a and use the difference of squares.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "t = (v − v₀)/a を代入し、平方差を使います。"
          }
        }
      }
    },
    "Substitute the threshold itself and inspect whether the operator contains equality.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Substitute the threshold itself and inspect whether the operator contains equality."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しきい値そのものを代入し、演算子が等号を含むか確認します。"
          }
        }
      }
    },
    "Substituting P into the negative-feedback closure gives [3/(s+1)]/[1+3/(s+1)]=3/(s+4). Evaluating at s=0 connects the block diagram to its final-value scale.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituting P into the negative-feedback closure gives [3/(s+1)]/[1+3/(s+1)]=3/(s+4). Evaluating at s=0 connects the block diagram to its final-value scale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "負フィードバック閉塞にPを置換すると、[3/(s+1)]/[1+3/(s+1)]=3/(s+4]が得られます。s=0で評価すると、ブロック図とその最終値スケールが接続されます。"
          }
        }
      }
    },
    "Substituting h = 0 before simplifying creates the indeterminate form 0/0 and skips the limiting argument.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Substituting h = 0 before simplifying creates the indeterminate form 0/0 and skips the limiting argument."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単純化する前にh = 0を置換すると、不確実な形式0/0が作成され、制限引数をスキップします。"
          }
        }
      }
    },
    "Substitution gives 4+2×5=14 kWh/day, but a useful interpretation also preserves the conditioning, units, range, and noncausal status of the fitted association.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitution gives 4+2×5=14 kWh/day, but a useful interpretation also preserves the conditioning, units, range, and noncausal status of the fitted association."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置換は4+2×5=14 kWh/日を与えますが、有用な解釈は、フィッティングされた結合の条件付け、単位、範囲、および非因果状態も保持します。"
          }
        }
      }
    },
    "Subtract %@": {
      "comment": "Step in a mental calculation chain; the placeholder is an exact number.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を減算します"
          }
        }
      }
    },
    "Subtract B from A, then bound the interpretation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtract B from A, then bound the interpretation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AからBを引いて、解釈を拘束します。"
          }
        }
      }
    },
    "Subtract and add 0.3 to obtain endpoints; the full span is 12.3−11.7=0.6 mm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtract and add 0.3 to obtain endpoints; the full span is 12.3−11.7=0.6 mm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端数を得るために0.3を減算して加えます。全体の範囲は12.3−11.7=0.6 mmです。"
          }
        }
      }
    },
    "Subtract b² from both sides": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両辺から b² を引きます"
          }
        }
      }
    },
    "Subtract endpoints and locate 0.50 relative to the interval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtract endpoints and locate 0.50 relative to the interval."
