        }
      }
    },
    "Check zero concentration, stoichiometric balance, and a limiting-reagent or equilibrium boundary.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Check zero concentration, stoichiometric balance, and a limiting-reagent or equilibrium boundary."
