    "Generated item": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成されたアイテム"
          }
        }
      }
    },
    "Generated question content is retained for 7 days, subject to a limit of 64 sets and 32 MB. Set metadata and personal attempt history remain after question content expires. Search covers all retained metadata, available questions, and every saved attempt. Question content and attempt history can be exported or deleted separately; set metadata remains as provenance until all local data is deleted in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated question content is retained for 7 days, subject to a limit of 64 sets and 32 MB. Set metadata and personal attempt history remain after question content expires. Search covers all retained metadata, available questions, and every saved attempt. Question content and attempt history can be exported or deleted separately; set metadata remains as provenance until all local data is deleted in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成された問題コンテンツは、64セットかつ32 MBの上限内で7日間保持されます。問題コンテンツの期限が切れた後も、セットのメタデータと個人の試行履歴は残ります。検索対象は、保持されたすべてのメタデータ、利用可能な問題、保存されたすべての試行です。問題コンテンツと試行履歴は個別にエクスポートまたは削除できます。セットのメタデータは、設定ですべてのローカルデータを削除するまで来歴情報として残ります。"
          }
        }
      }
    },
    "Generated question content is retained for 7 days, subject to a limit of 64 sets and 32 MB. Set metadata and personal attempt history remain after question content expires. You can search all retained metadata, export available questions, or explicitly delete retained question content.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated question content is retained for 7 days, subject to a limit of 64 sets and 32 MB. Set metadata and personal attempt history remain after question content expires. You can search all retained metadata, export available questions, or explicitly delete retained question content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成された問題内容は7日間保持され、最大64セット、32 MBに制限されます。セットのメタデータと個人の回答履歴は、問題内容の期限切れ後も残ります。保持中のメタデータを検索し、利用可能な問題を書き出したり、保持中の問題内容を明示的に削除したりできます。"
          }
        }
      }
    },
