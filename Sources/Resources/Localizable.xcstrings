            "value": "エクスポージャーと結果のラベル自体は、このグラフで共有される上流の原因ではありません。"
          }
        }
      }
    },
    "Express %lld/%lld of the %@ as an exact ratio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Express %1$lld/%2$lld of the %3$@ as an exact ratio."
