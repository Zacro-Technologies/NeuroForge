        }
      }
    },
    "AI is disabled.": {
      "comment": "On-device AI route policy explanation.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIは無効になっています。"
          }
        }
      }
    },
    "AI is disabled; used offline deterministic authoring.": {
      "comment": "AI generation fallback explanation.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIが無効なため、オフラインの決定論的な作問を使用しました。"
          }
        }
      }
    },
    "AI is off. Offline question generation remains available.": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIはオフです。オフラインでの問題生成は引き続き利用できます。"
          }
        }
      }
    },
    "AI mode": {
