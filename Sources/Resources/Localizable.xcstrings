    "Equal groups give total = group count × amount per group = %@ × %@ = %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Equal groups give total = group count × amount per group = %@ × %@ = %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループが同じなら、合計＝グループ数×グループあたりの量＝%@ × %@ = %@です。"
          }
        }
      }
    },
    "Equal voltage across parallel branches does not imply equal current unless their resistances are equal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Equal voltage across parallel branches does not imply equal current unless their resistances are equal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並列分岐における等電圧は、その抵抗が等しい場合を除いて、等電流を意味するものではありません。"
          }
        }
      }
    },
    "Equate lost gravitational potential energy with gained kinetic energy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equate lost gravitational potential energy with gained kinetic energy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失われた重力潜在エネルギーと得られた動能を同等にする。"
