    "Sensitivity to one assumption describes model dependence, not measurement uncertainty from every source.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sensitivity to one assumption describes model dependence, not measurement uncertainty from every source."
          }
        },
        "ja": {
          "stringUnit": {
