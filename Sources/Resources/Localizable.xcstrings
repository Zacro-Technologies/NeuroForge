          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この固定の問題セットは保存されたままです。残りの問題数に合わせて、別の確認済みの活動を始めます。"
          }
        }
      }
    },
    "This improves assignment, but a score contrast could now come from the unmatched tests rather than the workshop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This improves assignment, but a score contrast could now come from the unmatched tests rather than the workshop."
          }
