    "Interval": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔"
          }
        }
      }
    },
    "Interval width is 0.68−0.56=0.12. Because 0.50 lies below the lower endpoint, it is outside the reported interval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interval width is 0.68−0.56=0.12. Because 0.50 lies below the lower endpoint, it is outside the reported interval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔幅は0.68−0.56=0.12です。0.50が下限終点以下にあるため、報告された間隔の外側です。"
          }
        }
      }
    },
    "Interval width is upper minus lower. A valid closed range must preserve lower ≤ upper, so a reversed or overshooting lower boundary is invalid.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Interval width is upper minus lower. A valid closed range must preserve lower ≤ upper, so a reversed or overshooting lower boundary is invalid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区間の幅は上限から下限を引いた値です。有効な閉区間では下限 ≤ 上限を保つ必要があるため、下限が逆転したり上限を超えたりする設定は無効です。"
          }
        }
      }
    },
    "Invalid implication": {
      "comment": "Learner-selectable item-level error reflection category.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効な含意"
          }
        }
      }
    },
