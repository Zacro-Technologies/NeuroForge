    "Only the next question is selected now. If eligible content runs out, your work stays saved and the app offers an explicit alternative.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the next question is selected now. If eligible content runs out, your work stays saved and the app offers an explicit alternative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今選ぶのは次の1問だけです。出題可能な内容がなくなっても取り組みは保存され、別の選択肢が提示されます。"
          }
        }
      }
    },
