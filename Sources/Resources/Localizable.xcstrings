    "Remove saved copy?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove saved copy?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したコピーを削除しますか？"
          }
        }
      }
    },
    "Remove the final addition": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の加算を取り除く"
          }
        }
      }
    },
    "Remove the post-outcome feature and add a negative-control or temporal-availability audit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Remove the post-outcome feature and add a negative-control or temporal-availability audit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果後の機能を取り除き、負の制御または時間的可用性監査を追加します。"
          }
        }
      }
    },
    "Remove the post-outcome feature or shift the prediction timestamp; it leaks future target information.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the post-outcome feature or shift the prediction timestamp; it leaks future target information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果後の機能を除去するか、予測タイムスタンプをシフトしてください。将来のターゲット情報を漏洩します。"
          }
        }
      }
    },
    "Remove this device’s profile, training history, and imported app copies. Original source files outside NeuroForge are not changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのプロファイル、トレーニング履歴、インポートされたアプリのコピーを削除します。NeuroForge以外の元のソースファイルは変更されません。"
          }
        }
      }
    },
    "Remove this unavailable source from the selection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this unavailable source from the selection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できないこのソースを選択から外してください。"
          }
        }
      }
    },
    "Remove your NeuroForge profile, practice history, and imported copies from this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove your NeuroForge profile, practice history, and imported copies from this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeuroForgeのプロフィール、練習履歴、インポートしたコピーをこのデバイスから削除します。"
          }
        }
      }
    },
    "Removing an element shifts later indices left while the loop still follows the old index sequence, so it can skip values or access an index that no longer exists.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing an element shifts later indices left while the loop still follows the old index sequence, so it can skip values or access an index that no longer exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要素を削除すると、ループが古いインデックスシーケンスに従っている間、インデックスが後方にシフトするため、値がスキップされたり、存在しなくなったインデックスにアクセスしたりできます。"
          }
        }
      }
    },
    "Reopen NeuroForge to apply the iCloud sync change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reopen NeuroForge to apply the iCloud sync change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期の変更を反映するには、NeuroForgeを開き直してください。"
          }
        }
      }
    },
    "Reopen NeuroForge to finish turning sync off. Your data stays on this device.": {
      "comment": "iCloud-sync disable confirmation with a concise restart instruction.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeuroForgeを再度開くと同期が停止します。データはこのデバイスに残ります。"
          }
        }
      }
    },
    "Reopen NeuroForge to start syncing. You can keep using the app now.": {
      "comment": "iCloud-sync enable confirmation with a concise restart instruction.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeuroForgeを再度開くと同期が始まります。今はそのままアプリを使い続けられます。"
          }
        }
      }
    },
    "Repeat across independently prepared specimens or batches, not only repeated readings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Repeat across independently prepared specimens or batches, not only repeated readings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返し測定だけでなく、独立して準備した標本やバッチ全体で繰り返します。"
          }
        }
      }
    },
    "Repeat at increasing precision and check convergence against an analytic bound.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Repeat at increasing precision and check convergence against an analytic bound."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "精度を上げて繰り返し、解析拘束に対して収束をチェックします。"
          }
        }
      }
    },
    "Repeat the comparison across batches or blocks to reveal a treatment-by-batch dependence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Repeat the comparison across batches or blocks to reveal a treatment-by-batch dependence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチまたはブロック全体で比較を繰り返して、バッチごとの処理依存関係を明らかにします。"
          }
        }
      }
    },
    "Repeat the original examples verbatim": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の例をそのまま繰り返す"
          }
        }
      }
    },
    "Repeat the same observational comparison with more convenience-selected cases.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より便宜的に選択されたケースを使用して、同じ観察比較を繰り返します。"
          }
        }
      }
    },
    "Repeated exact work with an audit requirement favors a reproducible scripted or spreadsheet method.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監査要件に合わせて正確な作業を繰り返す場合は、再現可能なスクリプトまたはスプレッドシートによる方法が有利になります。"
          }
        }
      }
    },
    "Repeated measurements from the same unit are counted as independent units.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Repeated measurements from the same unit are counted as independent units."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ単位からの繰り返し測定は独立した単位としてカウントされます。"
          }
        }
      }
    },
    "Repeated measurements on one patient share patient-level variation and are not independent observations. Pairing models that dependence and tests the change within each patient.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated measurements on one patient share patient-level variation and are not independent observations. Pairing models that dependence and tests the change within each patient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ある患者に対する繰り返し測定は、患者レベルの変化を共有し、独立した観察ではありません。各患者内の変化に依存し、テストするペアリングモデル。"
          }
        }
      }
    },
    "Repeated retrieval separated by delay tests and strengthens access over time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔を空けた想起の反復は、時間が経過した後の想起を検証し、想起しやすさを高めます。"
          }
        }
      }
    },
    "Repeated rows from one patient share stable signals; row splitting lets the model recognize entities rather than generalize to unseen patients.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated rows from one patient share stable signals; row splitting lets the model recognize entities rather than generalize to unseen patients."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一人の患者からの繰り返し行は安定した信号を共有します。行分割により、モデルは表示されない患者に一般化するのではなく、エンティティを認識できます。"
          }
        }
      }
    },
    "Repeated scorer codes and confidence mismatches can schedule review; AI explanations cannot alter the saved score or evidence class.": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返されるスコアラー コードと確信度の不一致により、レビューがスケジュールされる可能性があります。 AI の説明では、保存されたスコアまたは証拠クラスを変更することはできません。"
          }
        }
      }
    },
    "Repeated selection chooses configurations partly for test-set noise, turning the test into training feedback and biasing the reported maximum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated selection chooses configurations partly for test-set noise, turning the test into training feedback and biasing the reported maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返し選択は、テストセットノイズのいくつ部分を選択し、テストをトレーニングフィードバックに変え、報告された最大値を偏向させます。"
          }
        }
      }
    },
    "Repeating the same confounded design adds precision without identification.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ混乱したデザインを繰り返すと、識別することなく精度が高まります。"
          }
        }
      }
    },
    "Replace %@ with %@ so the transcription matches the cited source line.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Replace %1$@ with %2$@ so the transcription matches the cited source line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
