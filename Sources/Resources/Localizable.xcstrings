    "Supports the reviewed expected answer for this retrieval item.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この検索項目に対するレビュー済みの予想回答をサポートします。"
          }
        }
      }
    },
    "Swap the numerator and denominator": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分子と分母を入れ替える"
          }
        }
      }
    },
    "Swift-like": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift風"
          }
        }
      }
    },
    "SwiftData does not expose enough transaction identity for NeuroForge to verify one exact structured-record deletion in private iCloud. To prevent partial erasure, this request stops before deleting synced originals or local data.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftDataは、プライベートiCloud内の特定の構造化レコード削除をNeuroForgeが検証するために必要なトランザクション識別情報を公開していません。一部だけが消去されることを防ぐため、このリクエストは同期済みの元ファイルやローカルデータを削除する前に停止します。"
          }
        }
      }
    },
    "SwiftData reported %@. Local records remain authoritative and available for export.": {
      "comment": "Structured private-iCloud failure status; placeholder is a redacted code.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftDataから%1$@が報告されました。ローカルレコードが引き続き正本であり、書き出し可能です。"
          }
        }
      }
    },
    "SwiftData reported successful processing and no later durable local write is awaiting export. Remote propagation timing remains system-managed.": {
      "comment": "Structured private-iCloud success status with propagation caveat.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftDataから処理成功が報告され、その後に書き出し待ちとなる永続的なローカル書き込みはありません。リモートへの反映タイミングは引き続きシステムが管理します。"
          }
        }
      }
    },
    "SwiftData reports %lld CloudKit operation(s) in progress.": {
      "comment": "Structured private-iCloud active-event status; placeholder is active event count.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftDataで%1$lld件のCloudKit操作が進行中です。"
          }
        }
      }
    },
    "Switch between native three-dimensional geometry and a motion-free schematic. The original description remains available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between native three-dimensional geometry and a motion-free schematic. The original description remains available."
          }
