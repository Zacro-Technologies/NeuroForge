        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4mを400cmに変換し、各本あたり2.5cmで割ります：400 ÷ 2.5 = 160。"
          }
        }
      }
    },
    "Convert MPa to GPa after dividing.": {
