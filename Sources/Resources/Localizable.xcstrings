          }
        }
      }
    },
    "Quit every NeuroForge window and reopen the app to continue this restore before study tools start.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit every NeuroForge window and reopen the app to continue this restore before study tools start."
          }
        },
        "ja": {
          "stringUnit": {
