    "Controlled scenarios vary surface field while preserving a defined reasoning structure and deterministic reference rationale.": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制御されたシナリオは、定義された推論構造と決定論的な参照根拠を維持しながら、表面フィールドを変化させます。"
          }
        }
      }
    },
    "Controller A implements negative feedback; controller B reinforces the disturbance and tends toward positive-feedback growth or instability.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controller A implements negative feedback; controller B reinforces the disturbance and tends toward positive-feedback growth or instability."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラAは負のフィードバックを実現し、コントローラBは乱気流を強化し、正のフィードバックの成長や不安定さに傾きます。"
          }
        }
      }
    },
    "Controls, replication unit, sampling frame, and nuisance variables must be declared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Controls, replication unit, sampling frame, and nuisance variables must be declared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制御、レプリケーションユニット、サンプリングフレーム、および迷惑な変数は宣言する必要があります。"
          }
        }
      }
    },
    "Convenience": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利便性"
          }
        }
      }
    },
    "Convenience assignment differs systematically between groups.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "便宜的な割り当てはグループ間で体系的に異なります。"
          }
        }
      }
    },
    "Convenience assignment limits causal comparability, and the truncated axis can exaggerate the visual effect; raw data and replication are strengths.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "便宜的な割り当てにより因果関係の比較可能性が制限され、軸が切り捨てられると視覚効果が誇張される可能性があります。生データとレプリケーションが強みです。"
          }
        }
      }
    },
    "Convert %lld milli-%@ to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Convert %1$lld milli-%2$@ to %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lldミリ%2$@を%3$@に変換してください。"
          }
        }
      }
    },
    "Convert %lld millimeters to meters.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ミリメートルをメートルに変換します。"
          }
        }
      }
    },
    "Convert %lld%% to %lld/100, then multiply by %lld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Convert %1$lld%% to %2$lld/100, then multiply by %3$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%%を%2$lld/100に変換し、%3$lldを掛けます。"
          }
        }
      }
    },
    "Convert 12% to about 12 cM and compare it with the 50% independence benchmark.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert 12% to about 12 cM and compare it with the 50% independence benchmark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12%を約12cmに変換し、50%の独立基準と比較します。"
          }
        }
      }
    },
    "Convert 2.75 metres to millimetres. Return only the number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert 2.75 metres to millimetres. Return only the number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2.75メートルをミリメートルに変換します。数字だけを返します。"
          }
        }
      }
    },
    "Convert 4 m to 400 cm, then divide by 2.5 cm per book: 400 ÷ 2.5 = 160.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
