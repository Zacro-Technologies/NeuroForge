    },
    "The product is not exact; reconstruct it from a nearby known fact.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "積が正確ではありません。近い既知の計算結果から組み立て直してください。"
          }
        }
      }
    },
    "The product needs x∈R³ and returns a vector in R²; a 2×3 matrix cannot multiply an R² vector.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The product needs x∈R³ and returns a vector in R²; a 2×3 matrix cannot multiply an R² vector."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この製品はx∈R³を必要とし、R²でベクトルを返します。2×3行列はR²ベクトルを掛けることができません。"
          }
        }
      }
    },
    "The production store could not be opened. NeuroForge did not reset, migrate in place, or overwrite it.": {
      "comment": "Data-safety explanation in the exported database recovery read-me.",
      "localizations": {
        "ja": {
