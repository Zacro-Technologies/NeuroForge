          }
        }
      }
    },
    "A 90° counterclockwise rotation applies (x, y) → (−y, x), giving %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反時計回りの90°回転では(x, y) → (−y, x)を適用するため、%1$@になります。"
          }
        }
      }
    },
    "A 90° counterclockwise rotation applies (x,y)→(−y,x). Substituting (3,−2) gives (−(−2),3)=(2,3), preserving distance from the origin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 90° counterclockwise rotation applies (x,y)→(−y,x). Substituting (3,−2) gives (−(−2),3)=(2,3), preserving distance from the origin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆時計方向の90°回転を適用すると（x、y）→(−y、x）。（3、−2）を代入すると（−(−2）、3)=(2、3)が生成され、原点からの距離が保持されます。"
          }
        }
      }
    },
    "A 90° counterclockwise rotation maps (x, y) to (−y, x).": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
