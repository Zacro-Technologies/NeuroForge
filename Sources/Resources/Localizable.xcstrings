    },
    "From F=ma and v=at, v=Ft/m; it vanishes at t=0 and has units m/s.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From F=ma and v=at, v=Ft/m; it vanishes at t=0 and has units m/s."
          }
        },
