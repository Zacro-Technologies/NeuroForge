          }
        }
      }
    },
    "Waiting for the first successful private sync before reporting completion.": {
      "comment": "Private iCloud queue status explanation.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了を報告する前に、最初にプライベート同期が成功するまで待機しています。"
          }
        }
      }
    },
    "Waiting to sync. You can keep using the local copy.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期を待機中です。ローカルコピーは引き続き使用できます。"
