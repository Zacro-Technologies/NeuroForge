          }
        }
      }
    },
    "Add a topic or select at least one ready source.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トピックを追加するか、準備完了のソースを1つ以上選択してください。"
          }
        }
      }
    },
    "Add all measurements before dividing by count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add all measurements before dividing by count."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントで割る前に、すべての測定を追加します。"
          }
        }
      }
    },
    "Add and subtract f(x+h)g(x): [(fg)(x+h)−(fg)(x)]/h = f(x+h)[g(x+h)−g(x)]/h + g(x)[f(x+h)−f(x)]/h. Taking h→0 gives (fg)′=fg′+gf′.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add and subtract f(x+h)g(x): [(fg)(x+h)−(fg)(x)]/h = f(x+h)[g(x+h)−g(x)]/h + g(x)[f(x+h)−f(x)]/h. Taking h→0 gives (fg)′=fg′+gf′."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "f(x+h)g(x)を足し算して引く：[(fg)(x+h)−(fg)(x)]/h = f(x+h)[g(x+h)−g(x)]/h + g(x)[f(x+h)−f(x)]/h。h→0を取ると、(fg)′=fg′+gf′が得られます。"
          }
        }
      }
    },
    "Add annotation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注釈を追加する"
          }
        }
      }
    },
    "Add both tolerances: 55.0±0.5 mm, or [54.5,55.5] mm.": {
