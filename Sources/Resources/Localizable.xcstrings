            "value": "$$\\frac{n_A}{2} \\quad \\text{and} \\quad \\frac{n_B}{1}$$"
          }
        }
      }
    },
    "$$f'(x)=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h},$$": {
      "localizations": {
        "en": {
          "stringUnit": {
