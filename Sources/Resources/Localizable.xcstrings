          }
        }
      }
    },
    "Recombination frequency is 12/100=12%, approximating 12 cM at this low frequency. A value well below the 50% independent-assortment limit is evidence that the loci are linked; the 6 cM distractor incorrectly halves the rate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recombination frequency is 12/100=12%, approximating 12 cM at this low frequency. A value well below the 50% independent-assortment limit is evidence that the loci are linked; the 6 cM distractor incorrectly halves the rate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重合周率は12/100=12%であり、この低周波数で12cMに近づいています。 50%独立配備制限のかなり下にある値は、ロシックスがリンクされている証拠です。 6cMの変数はレートを正しく半分にします。"
          }
        }
      }
    },
    "Recommended next": {
      "localizations": {
