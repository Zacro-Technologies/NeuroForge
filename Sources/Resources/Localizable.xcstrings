    "Reconstruct a solution pattern from %@ for use in %@ after the original surface cues are removed. What sequence preserves valid transfer?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reconstruct a solution pattern from %1$@ for use in %2$@ after the original surface cues are removed. What sequence preserves valid transfer?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のサーフェス キューが削除された後、%2$@ で使用するために、%1$@ からソリューション パターンを再構築します。有効な転移を維持するにはどのようなシーケンスが必要ですか?"
          }
        }
      }
    },
    "Reconstruct the cited claim in one sentence while preserving every qualifier. Use only the cited excerpt.": {
