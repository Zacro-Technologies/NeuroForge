        }
      }
    },
    "The repaired context still failed bounded checks; the unchanged deterministic exercise set was used.": {
      "comment": "AI Practice Studio validation note after its single repair attempt falls back.",
      "localizations": {
        "ja": {
          "stringUnit": {
