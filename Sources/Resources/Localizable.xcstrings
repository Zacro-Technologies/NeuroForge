            "value": "$$\\frac{n(n + 1)}{2}$$"
          }
        }
      }
    },
    "$$\\frac{n_A}{2} \\quad \\text{and} \\quad \\frac{n_B}{1}$$": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "$$\\frac{n_A}{2} \\quad \\text{and} \\quad \\frac{n_B}{1}$$"
          }
        },
        "ja": {
