        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラインドまたはマスクの画像ラベルを作成し、事前に指定された分類ルーブリックまたは自動閾値を使用します。これは観察者のバイアスを対象としています。"
          }
        }
      }
    },
    "Blind outcome assessment to group assignment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果の評価者に群の割り付けを知らせない。"
