            "state": "translated",
            "value": "測定中にブラインドコンディションラベルを貼るか、事前に指定された自動エンドポイントを使用します。"
          }
        }
      }
    },
    "Blind image scoring; observer bias.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blind image scoring; observer bias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
