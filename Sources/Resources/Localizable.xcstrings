    "Reject negative edge weights before running Dijkstra, or switch to Bellman–Ford; the greedy finalization invariant requires nonnegative weights.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイクストラ法を実行する前に負の辺を拒否するか、Bellman–Ford 法へ切り替えてください。貪欲な確定不変条件には非負の重みが必要です。"
          }
        }
      }
    },
    "Reject negative weights before running Dijkstra.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイクストラ法を実行する前に負の重みを拒否してください。"
          }
        }
      }
    },
    "Reject new failures": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新たな失敗を拒否する"
          }
        }
      }
    },
    "Reject reversal, qualifier loss, and causal or universal upgrade.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject reversal, qualifier loss, and causal or universal upgrade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関係の逆転、限定表現の欠落、因果的・普遍的な主張への強化を避ける。"
          }
        }
      }
    },
    "Reject surface unit matching when the target violates the source proportional-clearance assumption.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject surface unit matching when the target violates the source proportional-clearance assumption."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターゲットがソース比例クリアランス仮定に違反したときにサーフェス単位のマッチングを拒否します。"
          }
        }
      }
    },
    "Reject the C·s product, restore I=Q/Δt, and obtain 5 A.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject the C·s product, restore I=Q/Δt, and obtain 5 A."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "C·s製品を拒否し、I=Q/Δtを回復し、5 Aを得ます。"
          }
        }
      }
    },
    "Reject the confounded material comparison and require a controlled S–N comparison.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject the confounded material comparison and require a controlled S–N comparison."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "混乱した材料比較を拒否し、制御されたS-N比較を要求します。"
          }
        }
      }
    },
    "Reject the dimensionally inconsistent product and divide charge by time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject the dimensionally inconsistent product and divide charge by time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寸法的に矛盾する製品を拒否し、充電を時間で割います。"
          }
        }
      }
    },
    "Reject the inverted mole ratio and calculate 12 mol H₂ with explicit unit cancellation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject the inverted mole ratio and calculate 12 mol H₂ with explicit unit cancellation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆モル比を拒否し、明示的な単位キャンセルで12mol H2を計算します。"
          }
        }
      }
    },
    "Reject the null; p=0.03 does not mean the null has a 3% probability of being true.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject the null; p=0.03 does not mean the null has a 3% probability of being true."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヌルを拒否する。p=0.03はヌルが真である確率は3%であることを意味しない。"
          }
        }
      }
    },
    "Reject the unsupported converse.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "裏づけのない逆を退ける。"
          }
        }
      }
    },
    "Reject the unsupported negation and universalization.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "裏づけのない否定と普遍化を退ける。"
