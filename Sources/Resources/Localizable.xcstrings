    "Remove every NeuroForge-managed local privacy surface from this device. Private iCloud data is a separate action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove every NeuroForge-managed local privacy surface from this device. Private iCloud data is a separate action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからNeuroForgeが管理するすべてのローカルデータ領域を削除します。プライベートiCloudデータの削除は別の操作です。"
          }
        }
      }
    },
    "Remove every negative value without invalidating an index that the loop will later reuse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove every negative value without invalidating an index that the loop will later reuse."
          }
        },
        "ja": {
