    },
    "Choice of study routine can be associated with motivation or prior skill before treatment. Random allocation breaks that systematic assignment path in expectation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choice of study routine can be associated with motivation or prior skill before treatment. Random allocation breaks that systematic assignment path in expectation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "研究ルーチンの選択は、治療前の動機付けや以前のスキルに関連付けられます。無作為配分は、期待に基づいて体系的な割り当てパスを破ります。"
          }
        }
      }
    },
    "Choice selection mismatch": {
      "comment": "Deterministic scoring-error label.",
