    "Margin percentage = (72 − 48)/48 × 100 = 24/48 × 100 = 50%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Margin percentage = (72 − 48)/48 × 100 = 24/48 × 100 = 50%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "余白パーセンテージ=（72−48）/48×100=24/48×100=50％。"
          }
        }
      }
    },
    "Margin=1.96×2=3.92, so endpoints are 50−3.92 and 50+3.92.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Margin=1.96×2=3.92, so endpoints are 50−3.92 and 50+3.92."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "余白=1.96×2=3.92、つまり終点は50−3.92と50+3.92です。"
          }
        }
      }
    },
    "Mark a vertex finalized on minimum-key removal, not on insertion.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頂点は挿入時ではなく、最小キーとして取り出されたときに確定してください。"
          }
        }
      }
    },
    "Mark preserved features": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたフィーチャにマークを付ける"
          }
        }
      }
    },
    "Mark u visited before recursing and skip any neighbor already visited; otherwise a→b→c→a recurses forever before any vertex is recorded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark u visited before recursing and skip any neighbor already visited; otherwise a→b→c→a recurses forever before any vertex is recorded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再帰する前にマークuが訪問し、すでに訪問した隣人をスキップします。そうしないと、頂点が記録される前にa→b→c→aが永遠に再帰します。"
          }
        }
      }
    },
    "Mark u visited before recursing into its neighbors; marking it afterward allows a cycle to re-enter u indefinitely.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隣接頂点へ再帰する前に u を訪問済みとしてください。後で記録すると、閉路から u へ無限に再進入できます。"
          }
        }
      }
    },
    "Markdown": {
      "comment": "Supported study-material import format.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown"
          }
        }
      }
    },
    "Marked recaptures belong in the denominator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked recaptures belong in the denominator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切られた再捕獲は分母に属します。"
          }
        }
      }
    },
    "Marks any remaining uncertainty": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残っている不確実性をマークします"
          }
        }
      }
    },
    "Mass belongs in the denominator when solving for acceleration.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mass belongs in the denominator when solving for acceleration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質量は加速度を解くときに分母に属します。"
          }
        }
      }
    },
    "Mass cancels from mgh=½mv². Thus v=√(2gh)=√(2×10×5)=10 m/s, which also has the correct √(length²/time²) dimension.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mass cancels from mgh=½mv². Thus v=√(2gh)=√(2×10×5)=10 m/s, which also has the correct √(length²/time²) dimension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質量はmgh=½mv²からキャンセルされます。したがって、v=√(2gh)=√(2×10×5)=10 m/sで、これも正しい√(長さ²/時間²)次元を持っています。"
          }
        }
      }
    },
    "Mass-only scaling fails because clearance is not proportional to mass across ages; use an age-validated pediatric model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mass-only scaling fails because clearance is not proportional to mass across ages; use an age-validated pediatric model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マス専用の尺度は、クリアランスが年齢別のマスに比例しないため失敗します。年齢検証済みの小児モデルを使用してください。"
          }
        }
      }
    },
    "Match a concrete negative, known-active positive, and procedural control to three distinct failure questions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match a concrete negative, known-active positive, and procedural control to three distinct failure questions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "具体的なネガティブ、既知のアクティブネガティブ、およびプロシージャ制御を、3 つの異なる不合格質問と照合します。"
          }
        }
      }
    },
    "Match a figure's summary, uncertainty display, and raw-data access to the strength of its claim.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match a figure's summary, uncertainty display, and raw-data access to the strength of its claim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図の要約方法、不確かさの表示、元データへのアクセスが、主張の強さに見合っているか確認します。"
          }
        }
      }
    },
    "Match claim strength to stated evidence.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主張の強さを、示されたエビデンスに合わせる。"
          }
        }
      }
    },
    "Match diagram and equation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図と方程式の対応付け"
          }
        }
      }
    },
    "Match each defensible claim to the observation that supports it in this %@ experiment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この %1$@ 実験で、各擁護可能な主張をそれを裏付ける観察と照合してください。"
          }
        }
      }
    },
    "Match each evidence statement to the exact scope of its claim; association and causation require different support.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各証拠陳述をその主張の正確な範囲と一致させます。関連性と因果関係には異なるサポートが必要です。"
          }
        }
      }
    },
    "Match evaluation order to the prediction timeline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match evaluation order to the prediction timeline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価順序を予測タイムラインに一致させます。"
          }
        }
      }
    },
    "Match evidence to claim scope": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証拠を主張の範囲と照合する"
          }
        }
      }
    },
    "Match intervals, tests, and effect estimates to the question and assumptions.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区間、検定、効果推定を、問いと仮定に適切に対応させます。"
          }
        }
      }
    },
    "Match repeated extract-min to a min-heap.": {
