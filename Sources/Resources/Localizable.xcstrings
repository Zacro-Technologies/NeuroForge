        }
      }
    },
    "Folding across the y-axis is the reflection (x,y)→(−x,y). Thus B=(4,1) maps to B′=(−4,1), at the same perpendicular distance from the fold line.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folding across the y-axis is the reflection (x,y)→(−x,y). Thus B=(4,1) maps to B′=(−4,1), at the same perpendicular distance from the fold line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "y軸に沿って折畳まれるのは、反射（x、y）→（-x、y）です。したがって、B = = 4,1）は、折り畳み線からの同じ垂直距離でB′ =（-4,1）にマッピングされます。"
          }
        }
      }
    },
    "Folding and nets": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみとネット"
          }
        }
      }
    },
    "Follow the BST less-than branch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the BST less-than branch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BSTの支店未満に従ってください。"
          }
        }
      }
    },
    "Follow the arrowhead, not the left-to-right reading order alone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Follow the arrowhead, not the left-to-right reading order alone."
          }
        },
