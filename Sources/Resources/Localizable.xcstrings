            "value": "数式"
          }
        }
      }
    },
    "Equations use consistent mathematical formatting throughout questions and explanations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equations use consistent mathematical formatting throughout questions and explanations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題と解説の数式は、全体を通して一貫した数学表記で表示されます。"
          }
        }
      }
    },
    "Equilibrium alone fixes only the reaction sum. Symmetry supplies equality; changing the load location removes that assumption and makes the moment equation decisive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrium alone fixes only the reaction sum. Symmetry supplies equality; changing the load location removes that assumption and makes the moment equation decisive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡だけが反応合計を修正する。対称性は平等を提供し、荷重位置を変更するとその仮定が取り除かれ、モーメント方程式が決定的になります。"
          }
        }
      }
    },
    "Equilibrium and acid–base reasoning": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡と酸塩基の推論"
          }
        }
      }
    },
    "Equilibrium is dynamic: molecular events continue at equal opposing rates. The nearest distractor confuses no net change with no reaction.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrium is dynamic: molecular events continue at equal opposing rates. The nearest distractor confuses no net change with no reaction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡はダイナミックです。分子現象は等しい反対の速度で進行します。最も近い偏向は、正味の変化と反応がないことを混同させません。"
          }
        }
      }
    },
    "Equilibrium shifts toward products.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrium shifts toward products."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "均衡は製品に向かってシフトする。"
          }
        }
      }
    },
    "Equilibrium shifts toward reactants.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrium shifts toward reactants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平衡は反応物に向かってシフトする。"
          }
        }
      }
    },
    "Equivalent algebraic forms preserve the solution set only when each transformation is reversible or justified.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Equivalent algebraic forms preserve the solution set only when each transformation is reversible or justified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等価代数形式は、各変換が可逆的または正当化されている場合にのみソリューションセットを保持します。"
          }
        }
      }
    },
    "Equivalent multi-representation relation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "等価な複数表現関係"
          }
        }
      }
    },
    "Error detective: which trace correctly computes %lld%% of %lld?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Error detective: which trace correctly computes %1$lld%% of %2$lld?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー検出: %2$lld の %1$lld%% を正しく計算するトレースはどれですか?"
          }
        }
      }
    },
    "Error-pattern coaching": {
      "comment": "AI Practice Studio capability.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーパターンコーチング"
          }
        }
      }
    },
    "Establish P(k) → P(k + 1) under the induction hypothesis.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "帰納法の仮定のもとで P(k) → P(k + 1) を示します。"
          }
        }
      }
    },
    "Establish a nonempty precondition or represent absence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Establish a nonempty precondition or represent absence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空でない前置条件を設定するか、不在を表します。"
          }
        }
      }
    },
    "Establish load-before-reset ordering on the state owner.": {
      "localizations": {
        "en": {
