      }
    },
    "Use matched shafts with notch severity varied independently of bulk porosity, fatigue-test randomized replicates at the same stress, and use sectioning/fractography to record crack-initiation location. A notch effect with surface origins supports stress concentration; a porosity effect with internal origins supports the void mechanism.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use matched shafts with notch severity varied independently of bulk porosity, fatigue-test randomized replicates at the same stress, and use sectioning/fractography to record crack-initiation location. A notch effect with surface origins supports stress concentration; a porosity effect with internal origins supports the void mechanism."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バルク多孔率とは独立してノッチの重症度を変えるマッチングシャフトを使用し、同じ応力で疲労テストランダム複製を行い、断面法/断層法を使用してひび割れ開始位置を記録します。表面起源のノッチ効果は応力集中を支持し、内部起源の多孔効果は空洞メカニズムを支持します。"
          }
        }
      }
    },
    "Use min(aMoles / 2, bMoles), not max": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "maxではなくmin(aMoles / 2, bMoles)を使う"
          }
        }
      }
    },
    "Use min(high, max(low, x)); the current low/high positions are reversed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use min(high, max(low, x)); the current low/high positions are reversed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "min（高、max（低、x））を使用します。現在の低/高位置が逆さになります。"
          }
        }
      }
    },
    "Use multiple doses including zero across multiple time points, with vehicle and positive controls, and test dose-by-time response rather than one endpoint.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use multiple doses including zero across multiple time points, with vehicle and positive controls, and test dose-by-time response rather than one endpoint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "車両と陽性対照群で複数の時点にわたってゼロを含む複数の投与量を使用し、1つのエンドポイントではなく、時間ごとのテスト用量応答を使用します。"
          }
        }
      }
    },
    "Use natural frequencies for 10,000 people: disease prevalence is 1%, sensitivity is 90%, and the false-positive rate is 5%. What fraction of all positive tests are true positives? Round to four decimal places.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use natural frequencies for 10,000 people: disease prevalence is 1%, sensitivity is 90%, and the false-positive rate is 5%. What fraction of all positive tests are true positives? Round to four decimal places."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10,000人の自然周波数を使用します。疾患の有病率は1%、感性は90%、偽陽性率は5%です。すべての陽性検査の何割が真陽性ですか？小数点以下の四桁に切り上げます。"
          }
        }
      }
    },
    "Use net work to update kinetic energy, including the negative friction work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use net work to update kinetic energy, including the negative friction work."
