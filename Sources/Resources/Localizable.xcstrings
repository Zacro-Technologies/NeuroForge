    },
    "AI is disabled in Settings. Deterministic practice remains available.": {
      "comment": "Privacy-reviewed AI routing message.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でAIが無効になっています。決定論的な練習は引き続き利用できます。"
