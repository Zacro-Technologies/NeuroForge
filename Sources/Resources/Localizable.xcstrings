          "stringUnit": {
            "state": "translated",
            "value": "2つの分母を別々に計算します。"
          }
        }
      }
    },
    "Compute the visible contrast and keep it separate from the story around it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見えている差を計算し、それを周囲の説明と分けて考えます。"
          }
        }
      }
    },
    "Compute total count divided by quadrat count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compute total count divided by quadrat count."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計カウントを二乗カウントで割った計算。"
          }
        }
      }
    },
    "Compute true positives divided by true positives plus false positives.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真陽性を真陽性と偽陽性を加えた値で割った値を計算します。"
          }
        }
      }
    },
    "Compute tuner-equivalents, then round up to a whole worker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compute tuner-equivalents, then round up to a whole worker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チューナーと同等ものを計算し、丸めて全体のワーカーにします。"
          }
        }
      }
    },
    "Compute |f−fs|.": {
      "localizations": {
