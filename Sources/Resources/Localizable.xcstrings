            "state": "translated",
            "value": "選択したソース：%lld件"
          }
        }
      }
    },
    "Selecting agreement after observing outcomes destroys the comparison.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を観察した後に一致を選択すると、比較が破壊されます。"
          }
        }
      }
    },
    "Selection count out of range": {
