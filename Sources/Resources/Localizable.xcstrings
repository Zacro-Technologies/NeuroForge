            "value": "問題のリクエストをこのデバイスに保存できませんでした。"
          }
        }
      }
    },
    "The question set could not be removed. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The question set could not be removed. Try again."
          }
        },
        "ja": {
