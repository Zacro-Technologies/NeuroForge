    "Done": {
      "comment": "Action that closes a completed session or scratchpad.",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "Double the adjacent-node spacing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double the adjacent-node spacing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隣接ノードのスペースを2倍にする。"
          }
        }
      }
    },
    "Double the maximum frequency under the stated rule.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double the maximum frequency under the stated rule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "規定のルールの下で最大周波数を倍にする。"
          }
        }
      }
    },
    "Doubling the numerator contributes a factor of two and halving the denominator contributes another factor of two, for a fourfold result.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分子を 2 倍にすると係数 2 が寄与し、分母を半分にするとさらに係数 2 が寄与し、結果は 4 倍になります。"
          }
        }
      }
    },
    "Download a copy of your NeuroForge data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a copy of your NeuroForge data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeuroForgeデータのコピーをダウンロードします。"
          }
        }
      }
    },
    "Drag a step to an insertion line, or use Move up and Move down.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a step to an insertion line, or use Move up and Move down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手順を挿入線までドラッグするか、「上へ移動」「下へ移動」を使ってください。"
          }
        }
      }
    },
    "Drag the model to orbit. Nothing moves automatically; Static 2D is available above.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを軌道上にドラッグします。自動的に動くものは何もありません。静的2Dは上記で利用できます。"
          }
        }
      }
    },
    "Drag the view to orbit the camera. The object and answer are unchanged; Static 2D remains available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the view to orbit the camera. The object and answer are unchanged; Static 2D remains available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示をドラッグするとカメラが回り込みます。物体と解答は変わりません。「静的2D」も利用できます。"
          }
        }
      }
    },
    "Draw": {
      "comment": "iOS scratchpad mode rendered through a runtime String boundary.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画"
          }
        }
      }
    },
    "Draw a timeline for feature and outcome timestamps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a timeline for feature and outcome timestamps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィーチャーと出力のタイムスタンプのタイムラインを描画します。"
          }
        }
      }
    },
    "Draw an arrow from each state to the states it reads.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各状態から、その状態が読む依存先へ矢印を描いてください。"
          }
        }
      }
    },
    "Draw arrows from rainfall to both variables.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw arrows from rainfall to both variables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "降雨量から両方の変数まで矢印を描きます。"
          }
        }
      }
    },
    "Draw the first three recursion levels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the first three recursion levels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の3つの再帰レベルを描画します。"
          }
        }
      }
    },
    "Draw the free body, declare the symmetry assumption, solve 2R=20, and state its boundary.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the free body, declare the symmetry assumption, solve 2R=20, and state its boundary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自由体を描いて、対称性の仮定を宣言し、2R=20を解き、その境界を述べてください。"
          }
        }
      }
    },
    "Draw the free-body model for a simply supported beam with a pin and roller, then use the stated symmetry assumption for a centered 20 kN downward point load. What upward reaction acts at each support in kN? Return only the number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the free-body model for a simply supported beam with a pin and roller, then use the stated symmetry assumption for a centered 20 kN downward point load. What upward reaction acts at each support in kN? Return only the number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンとローラーを備えた単純支持ビームの自由体モデルを描き、中心下向き20kNポイント荷重に対して述べる対称仮定を使用します。 kNの各サポートで作用する上向きリアクションは何ですか？番号のみを返します。"
          }
        }
      }
    },
    "Draw the system boundary, balance loads, and audit whether a design margin is meaningful.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "系の境界を描き、荷重を釣り合わせ、設計余裕に意味があるか検証します。"
          }
        }
      }
    },
    "Draw with Apple Pencil or touch. Use the PencilKit palette for pen, eraser, and lasso tools.": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
