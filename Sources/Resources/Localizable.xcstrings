          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のセットから削除"
          }
        }
      }
    },
    "Remove labels and encode the relationship as an abstract rule.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルを削除し、関係を抽象ルールとしてエンコードします。"
