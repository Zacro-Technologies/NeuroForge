      }
    },
    "Test duplicate entities and future-derived features to reveal leakage that a random row split can hide.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Test duplicate entities and future-derived features to reveal leakage that a random row split can hide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダムな行スプリットが隠してしまう可能性のあるリークを明らかにするために、重複エンティティと将来派生的フィーチャをテストします。"
          }
        }
      }
    },
    "Test each candidate equation against more than one row.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各候補方程式を複数の行に対してテストします。"
          }
        }
      }
    },
    "Test empty, one-element, and just-over-boundary inputs before large examples.": {
      "localizations": {
