            "value": "ループが後で再利用するインデックスを無効にすることなく、すべての負の値を取り除きます。"
          }
        }
      }
    },
    "Remove favorite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove favorite"
          }
        },
        "ja": {
          "stringUnit": {
