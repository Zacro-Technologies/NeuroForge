    "Av=(2,0)ᵀ=2(1,0)ᵀ, so v is an eigenvector with λ=2. Geometrically, A preserves this direction and stretches vectors on it by a factor of 2.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Av=(2,0)ᵀ=2(1,0)ᵀ, so v is an eigenvector with λ=2. Geometrically, A preserves this direction and stretches vectors on it by a factor of 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Av=(2,0)ᵀ=2(1,0)ᵀなので、vはλ=2を持つ固有値です。幾何学的には、Aはこの方向を保持し、ベクトルを2の係数で伸ばします。"
          }
        }
      }
    },
    "Av=2v, hence λ=2; the line through v is an invariant direction scaled by 2.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Av=2v, hence λ=2; the line through v is an invariant direction scaled by 2."
          }
