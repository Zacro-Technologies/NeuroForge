          }
        }
      }
    },
    "Blind or mask image labels and use a prespecified classification rubric or automated threshold. This targets observer bias.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blind or mask image labels and use a prespecified classification rubric or automated threshold. This targets observer bias."
