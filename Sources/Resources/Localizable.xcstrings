          }
        }
      }
    },
    "R follows because P and P → R are given.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PとP → Rが与えられているため、Rが導かれる。"
          }
        }
      }
    },
    "R follows by modus ponens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーダスポネンスによりRが導かれる。"
          }
        }
      }
    },
    "R; modus ponens": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "R；モーダスポネンス"
          }
        }
      }
    },
    "Rainfall is a confounder; without controlling or designing around it, the umbrella-sales coefficient mixes rainfall’s common influence with any direct relation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rainfall is a confounder; without controlling or designing around it, the umbrella-sales coefficient mixes rainfall’s common influence with any direct relation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "降水量は混乱の原因です。それを制御したり設計したりせずに、傘販売係数は降水の一般的な影響と直接の関係を混合します。"
          }
        }
      }
    },
    "Raising temperature changes K and favors the endothermic reverse direction, so the equilibrium composition shifts toward reactants. The nearest distractor reverses this temperature response.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising temperature changes K and favors the endothermic reverse direction, so the equilibrium composition shifts toward reactants. The nearest distractor reverses this temperature response."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度上昇はKを変化させ、吸熱逆方向を支持するため、平衡組成はリアクターに向かってシフトします。最も近いディストラクタは、この温度応答を反転させます。"
          }
        }
      }
    },
    "Random assignment; selection confounding": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無作為割り付け；選択による交絡"
          }
        }
      }
    },
    "Random assignment; self-selection or baseline confounding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Random assignment; self-selection or baseline confounding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダムな配分、自己選択またはベースライン混同。"
          }
        }
      }
    },
    "Random rows from the same people and dates appear in train and test.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Random rows from the same people and dates appear in train and test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ人、同じ日付のランダムな行が、trainとtestに表示されます。"
          }
        }
      }
    },
    "Randomization within prior-skill blocks separates assignment from prior skill; the common calibrated test keeps measurement comparable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Randomization within prior-skill blocks separates assignment from prior skill; the common calibrated test keeps measurement comparable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前の技能による層内での無作為割り当てにより、技能とグループ分けの結び付きを切り離します。同じ尺度調整済みテストを使うことで、測定結果も比較可能になります。"
          }
        }
      }
    },
    "Randomization, blinded assessment, and predefined independent replication address distinct design threats; post-hoc exclusion introduces bias.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダム化、ブラインド評価、事前定義された独立したレプリケーションにより、明確な設計上の脅威に対処します。事後排除はバイアスをもたらします。"
          }
        }
      }
    },
    "Randomize and analyze at the actual independent assignment unit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Randomize and analyze at the actual independent assignment unit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の独立した割り当て単位でランダム化して分析します。"
          }
        }
      }
    },
    "Randomize or interleave run order and record the drift variable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Randomize or interleave run order and record the drift variable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダム化またはインターレース実行順序を行い、ドリフト変数を記録します。"
          }
        }
      }
    },
    "Randomize participants within prior-skill blocks, but give the groups different tests whose score scales have not been calibrated together.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Randomize participants within prior-skill blocks, but give the groups different tests whose score scales have not been calibrated together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前の技能で層別し、各層内で参加者を無作為に割り当てる。ただし、グループごとに異なるテストを実施し、得点尺度は共通になるよう調整しない。"
          }
        }
      }
    },
    "Randomize participants within prior-skill blocks, then give both groups the same calibrated test under blinded scoring.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Randomize participants within prior-skill blocks, then give both groups the same calibrated test under blinded scoring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前の技能で層別し、各層内で参加者を無作為に割り当てる。その後、両グループに同じ尺度調整済みテストを実施し、所属グループを知らない採点者が採点する。"
          }
        }
      }
    },
    "Randomize the candidate cause while using a calibrated independent outcome measurement.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "校正された独立した結果測定を使用しながら、候補原因をランダム化します。"
          }
        }
      }
    },
    "Randomize treatment allocation to reduce baseline confounding": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処置の割り付けを無作為化し、ベースラインの交絡を減らす"
          }
        }
      }
    },
    "Randomize treatment assignment before measuring the outcome.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Randomize treatment assignment before measuring the outcome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を測定する前に、治療の割り当てをランダムにします。"
          }
        }
      }
    },
    "Randomize treatment assignment where ethical and feasible.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "倫理的かつ実行可能な場合には、治療の割り当てをランダム化します。"
          }
        }
      }
    },
    "Randomize treatment when feasible or use a defensible matched or adjusted assignment design.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Randomize treatment when feasible or use a defensible matched or adjusted assignment design."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行可能な場合は治療をランダム化するか、防御可能なマッチングまたは調整された割り当て設計を使用します。"
          }
        }
      }
    },
    "Randomize within comparable baseline-growth strata.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Randomize within comparable baseline-growth strata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較可能な基準成長層内でランダム化します。"
          }
        }
      }
    },
    "Randomized A changes independent measure": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダム化された A は独立したメジャーを変更します"
          }
        }
      }
    },
    "Randomly assign consenting students to the new routine or usual study, ideally stratified by baseline score. This targets baseline self-selection confounding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Randomly assign consenting students to the new routine or usual study, ideally stratified by baseline score. This targets baseline self-selection confounding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同意する学生を新しいルーチンまたは通常の研究にランダムに割り当てます。理想的には、ベースラインスコアで分層します。 これは、ベースラインの自己選択混同を対象としています。"
          }
        }
      }
    },
    "Randomly assign exposure when ethical and feasible, or justify a design that addresses assignment confounding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Randomly assign exposure when ethical and feasible, or justify a design that addresses assignment confounding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "倫理的で実現可能な場合にランダムに曝露を割り当てたり、割り当ての混乱に対処する設計を正当化したりします。"
          }
        }
      }
    },
    "Randomly assign exposure when ethical and feasible; this addresses baseline selection confounding.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "倫理的かつ実行可能な場合は曝露を無作為に割り付けます。これにより、ベースラインの選択による交絡に対処できます。"
          }
        }
      }
    },
    "Rapid recall: what is %lld × %lld?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Rapid recall: what is %1$lld × %2$lld?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "即時想起：%1$lld × %2$lld はいくつですか？"
          }
        }
      }
    },
    "Rate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金"
          }
        }
      }
    },
    "Rate keeps the exposure interval in the denominator: %@ ÷ %@ = %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Rate keeps the exposure interval in the denominator: %@ ÷ %@ = %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "率では観測区間を分母に保ちます：%@ ÷ %@ = %@。"
          }
        }
      }
    },
    "Rate ratio 8/2=4 while concentration ratio is 2; because 2ⁿ=4, n=2.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate ratio 8/2=4 while concentration ratio is 2; because 2ⁿ=4, n=2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比率は8/2=4、濃度比率は2であるため、2ⁿ=4、n=2。"
          }
        }
      }
    },
    "Ratio 2; the rate doubles over this interval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratio 2; the rate doubles over this interval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比率2;この間隔でレートが倍増します。"
          }
        }
      }
    },
    "Rational numbers": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有理数"
          }
        }
      }
    },
    "Raw values": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生の値"
          }
        }
      }
    },
    "Re-run": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再実行"
          }
        }
      }
    },
    "Re-run short samples after changing a keyboard, pointer, touch setup, or Apple Pencil. These measurements never change correctness or mastery.": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード、ポインター、タッチ設定、または Apple Pencil を変更した後、短いサンプルを再実行します。これらの測定によって正確さや習熟度が変わることはありません。"
          }
        }
      }
    },
    "Re-run three trials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-run three trials"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3回の試行をやり直す"
          }
        }
      }
    },
    "Reach 20 recent attempts at 90% accuracy, use at least two valid strategy families, and clear repeated misconception codes from the last 10 attempts.": {
      "comment": "Mental-math progression requirement from flexibility to automaticity.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近20回の試行を90%の精度で達成し、少なくとも2つの有効な戦略ファミリーを使用し、最後の10回の試行から繰り返された誤解コードをクリアします。"
          }
        }
      }
    },
    "Reach at least 8 recent attempts with 80% accuracy; first exposure remains untimed.": {
      "comment": "Mental-math progression requirement from accuracy to flexibility.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近少なくとも8回の試行を80%の精度で達成します。最初の露出は時間調整されていないままになります。"
          }
        }
      }
    },
    "Reactant and product concentrations must be equal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactant and product concentrations must be equal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアクターと製品の濃度は等しいでなければなりません。"
          }
        }
      }
    },
    "Reacted A = 0.50×0.80 = 0.40 mol; the 1:2 ratio gives B = 2×0.40 = 0.80 mol.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reacted A = 0.50×0.80 = 0.40 mol; the 1:2 ratio gives B = 2×0.40 = 0.80 mol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反応したA = 0.50×0.80 = 0.40 mol; 1:2比率はB = 2×0.40 = 0.80 molを与えます。"
          }
        }
      }
    },
    "Reaction enthalpy is a final-minus-initial state-function difference. Addition loses direction and cannot distinguish exothermic from endothermic change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaction enthalpy is a final-minus-initial state-function difference. Addition loses direction and cannot distinguish exothermic from endothermic change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアクションエンタルピーは、最終マイナス初期状態関数差です。加算は方向を失い、放熱性変化と吸熱性変化を区別できません。"
          }
        }
      }
    },
    "Reaction extent is limited by the smallest coefficient-adjusted reactant amount.": {
      "localizations": {
