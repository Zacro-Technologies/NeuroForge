    "Positive rotations are counterclockwise when viewed from the positive axis toward the origin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive rotations are counterclockwise when viewed from the positive axis toward the origin."
          }
