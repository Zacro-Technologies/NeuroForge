        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終点を差し引いて、区間に対して0.50を求める。"
          }
        }
      }
    },
    "Subtract false-positive rate from true-positive rate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtract false-positive rate from true-positive rate."
