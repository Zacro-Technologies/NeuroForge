    },
    "Apple Pencil": {
      "comment": "Preferred answer-input mode. Apple Pencil is a product name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil"
          }
        }
      }
    },
    "Apple Pencil (optional)": {
      "comment": "Runtime catalog key used by a custom view or static user-facing content table.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil (オプション)"
          }
        }
      }
    },
    "Apple Pencil calibration is offered only on supported iPads. Each sample must be activated with the Pencil tip; finger, pointer, keyboard, and assistive activations are not recorded as Pencil input.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil calibration is offered only on supported iPads. Each sample must be activated with the Pencil tip; finger, pointer, keyboard, and assistive activations are not recorded as Pencil input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilのキャリブレーションは、対応するiPadでのみ利用できます。各サンプルはPencilの先端で操作する必要があり、指、ポインタ、キーボード、支援機能による操作はPencil入力として記録されません。"
          }
        }
      }
    },
    "Apple Pencil was not detected. Touch this button directly with the Pencil tip; this attempt was not recorded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil was not detected. Touch this button directly with the Pencil tip; this attempt was not recorded."
          }
        },
        "ja": {
