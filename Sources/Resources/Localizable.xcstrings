    },
    "Forge XP celebrates completed practice and breadth. It is separate from accuracy, transfer, retention, and skill evidence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge XP celebrates completed practice and breadth. It is separate from accuracy, transfer, retention, and skill evidence."
