            "value": "ステート所有者にリセット前の負荷順序を設定します。"
          }
        }
      }
    },
    "Estimate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概算"
          }
        }
      }
    },
    "Estimate %lld millimeters in meters, state whether the converted numeric value should be smaller or larger, then calculate the exact conversion.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ミリメートルをメートル単位で推定し、変換された数値が小さいか大きいかを示し、正確な変換を計算します。"
          }
        }
      }
    },
    "Estimate %lld × %lld %@, judge plausibility, then calculate exactly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Estimate %1$lld × %2$lld %3$@, judge plausibility, then calculate exactly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld × %2$lld %3$@ を推定し、妥当性を判断し、正確に計算します。"
          }
        }
      }
    },
    "Estimate %lld × %lld first, record whether that estimate makes the exact result plausible, then calculate the exact product.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Estimate %1$lld × %2$lld first, record whether that estimate makes the exact result plausible, then calculate the exact product."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、%1$lld × %2$lld を推定し、その推定が正確な結果を妥当なものにするかどうかを記録し、次に正確な積を計算します。"
          }
        }
      }
    },
    "Estimate annual passenger-kilometres for 100,000 commuters traveling about 10 km per workday over 250 workdays. Give the value in normalized scientific notation, then explain how doubling distance changes its coefficient and exponent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate annual passenger-kilometres for 100,000 commuters traveling about 10 km per workday over 250 workdays. Give the value in normalized scientific notation, then explain how doubling distance changes its coefficient and exponent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "250営業日間にわたって1営業日あたり約10 kmを移動する10万人の通勤者の年間乗車定員を推定します。正規科学記号で値を指定し、距離を倍増すると係数と指数が変わる理由を説明します。"
          }
        }
      }
    },
    "Estimate area before applying people per square metre.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate area before applying people per square metre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一平方メートルあたりの人を適用する前の面積を推定します。"
          }
        }
      }
    },
    "Estimate daily cups of coffee consumed in a city of 500,000 people. Assume 75% are coffee-drinking adults and those adults average 1.5 cups/day. Compute the estimate and give one sensitivity statement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate daily cups of coffee consumed in a city of 500,000 people. Assume 75% are coffee-drinking adults and those adults average 1.5 cups/day. Compute the estimate and give one sensitivity statement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人口50万人都市で消費される毎日のコーヒーカップを推定します。75%がコーヒーを飲む大人であり、その大人が平均して1.5カップ/日に消費すると仮定します。推定値を計算し、一つの感度ステートメントを与えます。"
          }
        }
      }
    },
    "Estimate full-time piano tuners for a city of 1.2 million people. Assume one piano per 30 residents, one service per piano per year, and 900 services per tuner-year. Show the factorization, round workers appropriately, and name one demand-driving assumption.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate full-time piano tuners for a city of 1.2 million people. Assume one piano per 30 residents, one service per piano per year, and 900 services per tuner-year. Show the factorization, round workers appropriately, and name one demand-driving assumption."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人口120万人の都市のフルタイムピアノチューナーの見積もり。住民30人に1台のピアノ、年間1台のピアノのサービス、チューナー年あたり900回のサービスを想定します。因数分解を示し、労働者を適切に丸め、需要を牽引する仮定を1つ命名します。"
          }
        }
      }
    },
