        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点A=(3,−2)は、原点に対して逆時計回りに90°回転します。変換された座標を返す。"
          }
        }
      }
    },
    "Point P begins at x %lld, y %lld; rotate its coordinate pair counterclockwise by ninety degrees.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Point P begins at x %1$lld, y %2$lld; rotate its coordinate pair counterclockwise by ninety degrees."
