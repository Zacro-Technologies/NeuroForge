    },
    "Subtract work done by the system from absorbed heat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtract work done by the system from absorbed heat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸収された熱からシステムが行った作業を差し引く。"
