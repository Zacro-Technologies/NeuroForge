      }
    },
    "Separate an observed rate-law exponent from an elementary-step claim.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate an observed rate-law exponent from an elementary-step claim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観測された比率法則指数を一次ステップの主張から分離します。"
          }
        }
      }
    },
    "Separate evidence against zero from the value of the effect’s magnitude.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate evidence against zero from the value of the effect’s magnitude."
          }
        },
        "ja": {
