    },
    "Subtracting the same expression from both sides preserves the solution set and yields": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtracting the same expression from both sides preserves the solution set and yields"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両辺から同じ式を引いても解集合は保たれ、次を得ます"
