    "If four divides n, then two divides n": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4 で n を割る場合、2 で n を割ります"
          }
        }
      }
    },
    "If n=2k, then n²=4k² is even. If n=2k+1, then n²=4k²+4k+1=2(2k²+2k)+1 is odd. Thus n² has the same parity as n.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If n=2k, then n²=4k² is even. If n=2k+1, then n²=4k²+4k+1=2(2k²+2k)+1 is odd. Thus n² has the same parity as n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "n=2kの場合、n²=4k²は偶数です。n=2k+1の場合、n²=4k²+4k+1=2(2k²+2k)+1は奇数です。したがって、n²はnと同じパリティを持っています。"
          }
        }
      }
    },
    "If not Q, then not P": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Q でない場合は P ではありません"
          }
        }
      }
    },
