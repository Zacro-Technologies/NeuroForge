          }
        }
      }
    },
    "This is a personal comparison with your source. It does not change skill scores.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a personal comparison with your source. It does not change skill scores."
          }
        },
