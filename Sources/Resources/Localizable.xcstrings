    },
    "Incorrect numeric value": {
      "comment": "Deterministic scoring-error label.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値が正しくありません"
          }
        }
      }
    },
    "Increase %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を増やす"
          }
        }
      }
    },
    "Increase or activate the inhibitor when signalHigh; setting it to zero removes negative feedback.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase or activate the inhibitor when signalHigh; setting it to zero removes negative feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信号が高いときに阻害剤を増加または活性化します。ゼロに設定すると、ネガティブフィードバックが除去されます。"
          }
        }
      }
    },
    "Increment i before continue, or use a for loop; the negative branch repeats the same index forever.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increment i before continue, or use a for loop; the negative branch repeats the same index forever."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける前にiを増やすか、ループforを使用してください。負のブランチは同じインデックスを永遠に繰り返します。"
          }
        }
      }
    },
    "Increment index by 2.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックスを 2 増やします。"
          }
        }
      }
    },
    "Independence gives P(A ∩ B) = P(A)P(B) = 0.30 × 0.40 = 0.12.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independence gives P(A ∩ B) = P(A)P(B) = 0.30 × 0.40 = 0.12."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立性は、P(A ∩ B) = P(A)P(B) = 0.30 × 0.40 = 0.12を与えます。"
          }
        }
      }
    },
    "Independent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支援なし"
          }
        }
      }
    },
    "Independent accuracy": {
      "comment": "Independent mental-math progress metric.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した精度"
          }
        }
      }
    },
    "Independent answer authority is unavailable without cited source material; used deterministic authoring.": {
      "comment": "AI routing explanation when a model cannot provide an independently checked answer key.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用できる資料がなく正解を独立して確定できないため、決定論的な作問を使用しました。"
          }
        }
      }
    },
    "Independent assortment cannot be assumed for loci whose linkage is under investigation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Independent assortment cannot be assumed for loci whose linkage is under investigation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンケージが調査中のロキスについては、独立したアソートメントを想定することはできません。"
          }
        }
      }
    },
    "Independent evidence unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent evidence unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自力での成績の評価に利用不可"
          }
        }
      }
    },
    "Independent manipulation and measurement separate a real effect of A from drift in the original measurement process.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した操作と測定により、A の実際の効果と元の測定プロセスのドリフトが分離されます。"
          }
        }
      }
    },
    "Independent measure does not follow the drift": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した測定値がドリフトに追従しない"
          }
        }
      }
    },
    "Independent nested loops multiply their iteration counts, giving n×n operations rather than adding to n.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent nested loops multiply their iteration counts, giving n×n operations rather than adding to n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立したネストループは反復カウントを乗じ、n×nの演算をnに加えるのではなく、n×nの演算を与えます。"
          }
        }
      }
    },
    "Independent standard uncertainties are 3 N and 4 N. Combine them by root-sum-square.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent standard uncertainties are 3 N and 4 N. Combine them by root-sum-square."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した標準不確実性は3Nと4Nです。それらを平方根の和で組み合わせます。"
          }
        }
      }
    },
    "Independently checked model key": {
      "comment": "Authoring-validation status; model output passed a separate exact-restatement check.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立検証済みのモデル回答"
          }
        }
      }
    },
    "Index": {
      "localizations": {
