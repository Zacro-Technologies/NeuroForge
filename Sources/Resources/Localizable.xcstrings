    "Undo is available only while the current plan still exactly matches “%@” and no later answer or checkpoint depends on it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo is available only while the current plan still exactly matches “%@” and no later answer or checkpoint depends on it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻せるのは、現在のプランが「%@」と完全に一致し、その後の回答やチェックポイントが依存していない間だけです。"
          }
        }
      }
    },
    "Undo is last-in, first-out, exactly the stack discipline. A queue is tempting for ordered records but removes the oldest action first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo is last-in, first-out, exactly the stack discipline. A queue is tempting for ordered records but removes the oldest action first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すは、後着順、先着順、まさにスタック規律です。キューはソートされたレコードに誘惑しますが、古いアクションを最初に削除します。"
          }
        }
      }
    },
    "Undo is no longer safe because later work used or superseded this state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo is no longer safe because later work used or superseded this state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後の練習でこの状態が使用または更新されたため、安全に元へ戻せません。"
          }
        }
      }
    },
