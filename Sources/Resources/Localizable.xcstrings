            "value": "時間オフセットを1期間の分数として表す。"
          }
        }
      }
    },
    "Express the unknown total as a product of explicit, auditable assumptions.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未知の総量を、明示され検証可能な複数の仮定の積として表します。"
          }
        }
      }
    },
    "Extra context for this question": {
