          }
        }
      }
    },
    "Compute ΔG in kJ with both additive terms in the same unit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compute ΔG in kJ with both additive terms in the same unit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔGをキロジュール単位で計算し、両方の加法項を同じ単位で計算します。"
          }
        }
      }
    },
    "Compute ΔG=ΔH−TΔS and require ΔG<0; a negative ΔH alone is insufficient because the entropy term and temperature can reverse the sign.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compute ΔG=ΔH−TΔS and require ΔG<0; a negative ΔH alone is insufficient because the entropy term and temperature can reverse the sign."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ΔG=ΔH−TΔSを計算し、ΔG<0を要求します。逆 entropy 記号と温度は符号を反転させる可能性があるため、負の ΔH だけでは不十分です。"
          }
        }
      }
    },
    "Compute ΔL/L₀.": {
