    },
    "Interpret a compact source figure while preserving the supported direction, conditions, and scope.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpret a compact source figure while preserving the supported direction, conditions, and scope."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出典に含まれる簡潔な図を、裏づけられた関係の方向・条件・適用範囲を保って解釈します。"
          }
        }
      }
    },
    "Interpret coefficients and residuals while keeping prediction separate from causation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測と因果を分けながら、係数と残差を解釈します。"
          }
        }
      }
    },
    "Interpret dynamic interactions, sampling choices, and competing explanations in population data.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個体群データの動的相互作用、標本抽出、競合する説明を解釈します。"
          }
        }
      }
    },
    "Interpret effect size and statistical significance as different questions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpret effect size and statistical significance as different questions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "効果の大きさと統計的意義を異なる質問として解釈する。"
          }
        }
      }
    },
    "Interpret occupied-cell footprints and identify every assembly consistent with supplied views.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpret occupied-cell footprints and identify every assembly consistent with supplied views."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "占有セルの輪郭を読み取り、与えられた図に一致する積み方をすべて特定します。"
          }
        }
      }
    },
    "Interpret stress–strain evidence and distinguish a measured failure mode from its proposed cause.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応力–ひずみの証拠を解釈し、測定された破壊形態と推定原因を区別します。"
          }
        }
      }
    },
    "Interpret the coefficient before making a causal claim.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interpret the coefficient before making a causal claim."
          }
        },
