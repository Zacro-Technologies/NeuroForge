          }
        }
      }
    },
    "Execution inspection is recorded as support. Your first prediction stays saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Execution inspection is recorded as support. Your first prediction stays saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行結果の確認は補助の利用として記録されます。最初の予測は保存されたままです。"
          }
        }
      }
    },
    "Exothermic describes enthalpy direction, whereas spontaneity at fixed temperature and pressure is governed by Gibbs energy. Conflating them discards TΔS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exothermic describes enthalpy direction, whereas spontaneity at fixed temperature and pressure is governed by Gibbs energy. Conflating them discards TΔS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放熱はエンタルピー方向を表し、固定温度と圧力での自発性はギブスエネルギーによって支配されます。それらを衝突させると、TΔSが廃棄されます。"
          }
        }
      }
    },
    "Expand (2k+1)² and factor out 2 from all but the final 1.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand (2k+1)² and factor out 2 from all but the final 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大（2k+1）²し、最後の1を除くすべてから2を引出します。"
          }
        }
      }
    },
    "Expand (x + h)² before taking the limit.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "極限を取る前に (x + h)² を展開してください。"
          }
        }
      }
    },
    "Expand (x + h)² − x² = 2xh + h², divide by h, then take the limit to obtain 2x.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(x + h)² − x² = 2xh + h² と展開し、h で割ってから極限を取り、2x を得ます。"
          }
        }
      }
    },
    "Expand (x+h)² before dividing by h.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand (x+h)² before dividing by h."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hで割る前に（x+h）²を拡大する。"
          }
        }
      }
    },
    "Expand (x+h)²−x², cancel h, and take the limit to obtain 2x.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand (x+h)²−x², cancel h, and take the limit to obtain 2x."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開（x+h）²−x²、hをキャンセルし、極限を取って2xを得ます。"
          }
        }
      }
    },
    "Expand counter=counter+1 into read, add, and write.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand counter=counter+1 into read, add, and write."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウンター=カウンター+1を読み込み、追加、書き込みに展開します。"
          }
        }
      }
    },
    "Expanded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開中"
          }
        }
      }
    },
    "Expanding first exposes a common factor h. Cancelling that factor is valid for h ≠ 0 in the difference quotient, after which the limit of 2x + h is 2x.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に展開すると共通因子 h が現れます。差分商では h ≠ 0 なのでこの因子を約分でき、その後 2x + h の極限は 2x になります。"
          }
        }
      }
    },
    "Expansion exposes the factor h that may be cancelled before the limit is evaluated; direct substitution before simplification would only produce 0/0.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expansion exposes the factor h that may be cancelled before the limit is evaluated; direct substitution before simplification would only produce 0/0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開は、極限が評価される前にキャンセルされる可能性のある係数hを明らかにします。簡素化前の直接代入は、0/0しか生成しません。"
          }
        }
      }
    },
