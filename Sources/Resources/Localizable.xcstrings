    "Families keep their own starting targets. This is not a shared level or a fixed question order.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Families keep their own starting targets. This is not a shared level or a fixed question order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各系列にはそれぞれの開始目標があります。共通のレベルや固定された出題順を示すものではありません。"
          }
        }
      }
    },
    "No reviewed next question is available at these starting targets. The targets have been kept; choose an alternative explicitly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reviewed next question is available at these starting targets. The targets have been kept; choose an alternative explicitly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの開始目標では、次に出せるレビュー済み問題がありません。目標は維持されています。別の選択肢を明示的に選んでください。"
          }
        }
      }
    },
    "Some starting targets are currently unavailable. Mixed practice can begin in another eligible family without lowering those targets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some starting targets are currently unavailable. Mixed practice can begin in another eligible family without lowering those targets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の開始目標では現在出題できません。目標を下げずに、条件を満たす別の系列からミックス練習を始められます。"
          }
        }
      }
    },
    "Each family has a reviewed next question at its starting target. Later questions depend on your answers and the remaining eligible content.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each family has a reviewed next question at its starting target. Later questions depend on your answers and the remaining eligible content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各系列には開始目標に合う次のレビュー済み問題があります。その後の問題は、回答と残りの出題可能な内容に応じて決まります。"
          }
        }
      }
    },
    "A next question is available at this target.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A next question is available at this target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この目標で次の問題を出題できます。"
