    "Partition the set into six boxes {1,2},{3,4},…,{11,12}. Placing seven chosen integers into six boxes forces two into the same box by the pigeonhole principle, and those two differ by 1.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partition the set into six boxes {1,2},{3,4},…,{11,12}. Placing seven chosen integers into six boxes forces two into the same box by the pigeonhole principle, and those two differ by 1."
          }
