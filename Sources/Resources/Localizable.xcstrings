    "Point A has x %lld, y %lld, z %lld. A quarter-turn about z maps x and y while leaving z fixed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Point A has x %1$lld, y %2$lld, z %3$lld. A quarter-turn about z maps x and y while leaving z fixed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点 A には x %1$lld、y %2$lld、z %3$lld があります。 z を固定したまま、z を中心に 4 分の 1 回転すると、x と y がマップされます。"
          }
        }
      }
    },
    "Point A=(3,−2) is rotated 90° counterclockwise about the origin. Return the transformed coordinate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point A=(3,−2) is rotated 90° counterclockwise about the origin. Return the transformed coordinate."
