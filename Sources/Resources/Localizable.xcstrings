    "A %@ check has %lld groups of %lld. How many %@ are represented?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %1$@ check has %2$lld groups of %3$lld. How many %4$@ are represented?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の確認では、%3$lld個ずつのグループが%2$lld組あります。表される%4$@はいくつですか？"
          }
        }
      }
    },
    "A %@ estimate is %@ %@ with uncertainty interval [%@, %@]. State the interval width and whether the interval means every value inside is equally likely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %@ estimate is %@ %@ with uncertainty interval [%@, %@]. State the interval width and whether the interval means every value inside is equally likely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の推定値は%@ %@で、不確実性区間は[%@、%@]です。区間幅を求め、この区間が内部のすべての値の可能性が等しいことを意味するか述べてください。"
          }
        }
      }
    },
    "A %@ intersected by a specified plane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定された平面と交差する A %1$@"
          }
        }
      }
    },
    "A %@ mM stock contributes %@ mL to a final volume of %@ mL. What is the final concentration in mM? Return only the number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %1$@ mM stock contributes %2$@ mL to a final volume of %3$@ mL. What is the final concentration in mM? Return only the number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "濃度%@ mMの原液を%@ mL取り、最終体積を%@ mLにしました。最終濃度は何mMですか？数値だけを入力してください。"
          }
        }
      }
    },
    "A %@ measure rises from %@ to %@ %@. Compute the percentage change relative to the first value, and name the denominator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %@ measure rises from %@ to %@ %@. Compute the percentage change relative to the first value, and name the denominator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の測定値が%@から%@ %@へ増加します。最初の値を基準とする変化率を計算し、分母を示してください。"
          }
        }
      }
    },
    "A %@ measurement changes from %@ to %@ %@. Compute the signed change final − initial. Return only the number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %@ measurement changes from %@ to %@ %@. Compute the signed change final − initial. Return only the number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の測定値が%@から%@ %@へ変化します。符号付き変化（最終値−初期値）を計算してください。数値だけを答えてください。"
          }
        }
      }
    },
    "A %@ pilot reports the following outcome means": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の予備調査では、次の結果の平均値が報告されています"
          }
        }
      }
    },
    "A %@ record reports %@ %@ across %@ %@s. What is the mean rate in %@ per %@? Return only the number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %@ record reports %@ %@ across %@ %@s. What is the mean rate in %@ per %@? Return only the number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の記録では、%@ %@が%@ %@にわたって報告されています。%@あたり%@の平均率を求めてください。数値だけを答えてください。"
          }
        }
      }
    },
    "A %@ rule says: if a record is verified, it may be published. The record was published. What follows logically?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の規則では、記録が検証済みなら公開可能だとされています。その記録は公開されました。論理的に何が導かれますか？"
          }
        }
      }
    },
    "A %@ sample contains %lld cases and %lld%% meet a criterion. What is the expected count?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %1$@ sample contains %2$lld cases and %3$lld%% meet a criterion. What is the expected count?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の標本には%2$lld件の事例があり、その%3$lld%%が基準を満たします。期待される件数はいくつですか？"
          }
        }
      }
    },
    "A %@ solution reaches a plausible result after an invalid step. Identify the diagnostic that locates the first unsupported step and justify the smallest repair.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %@ solution reaches a plausible result after an invalid step. Identify the diagnostic that locates the first unsupported step and justify the smallest repair."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の解答は、無効な手順の後でもっともらしい結果に達しています。最初の根拠のない手順を特定できる診断を挙げ、最小限の修正を説明してください。"
          }
        }
      }
    },
    "A %@ state model is implemented in a %@ simulation. Starting at %lld, the specification says ‘multiply by %lld, then add %lld once.’ Which trace is correct?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %1$@ state model is implemented in a %2$@ simulation. Starting at %3$lld, the specification says ‘multiply by %4$lld, then add %5$lld once.’ Which trace is correct?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 状態モデルは、%2$@ シミュレーションに実装されます。 %3$lld から始まる仕様では、「%4$lld を乗算し、%5$lld を 1 回加算する」と記載されています。どのトレースが正しいですか?"
          }
        }
      }
    },
    "A %@ table records %@ %@ over %@ %@s. Compute the mean rate and state its denominator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %@ table records %@ %@ over %@ %@s. Compute the mean rate and state its denominator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の表には、%@ %@が%@ %@にわたって記録されています。平均率を計算し、分母を示してください。"
          }
        }
      }
    },
    "A %@ table reports %@ then %@ %@. Compute the signed change second − first and state what that contrast alone cannot establish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %@ table reports %@ then %@ %@. Compute the signed change second − first and state what that contrast alone cannot establish."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の表には、%@、次に%@ %@と記録されています。符号付き変化（2番目−1番目）を計算し、この差だけでは何を確立できないか述べてください。"
          }
        }
      }
    },
    "A %@ workflow has %@ equal groups of %@ observations. How many observations are there? Return only the number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %1$@ workflow has %2$@ equal groups of %3$@ observations. How many observations are there? Return only the number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のワークフローには%@個の等しいグループがあり、各グループに%@件の観測があります。観測は合計何件ですか？数値だけを入力してください。"
          }
        }
      }
    },
    "A %@ workflow has %lld units in each batch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A %1$@ workflow has %2$lld units in each batch."
          }
        },
