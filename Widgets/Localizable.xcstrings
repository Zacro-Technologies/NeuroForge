        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリでプランを準備済み"
          }
        }
      }
    },
    "Start or continue today’s privacy-safe training plan.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のプライバシーに配慮したトレーニングプランを開始または続行します。"
          }
        }
